# DashScope / Qwen runtime
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key

# App runtime
AGENT_ENV=local
AGENT_DEFAULT_USER_ID=1005
AGENT_DEFAULT_USER_LOCATION=合肥
AGENT_CURRENT_MONTH=2025-09
AGENT_MODEL_PROVIDER=tongyi
AGENT_CHAT_MODEL_NAME=qwen3-max
AGENT_EMBEDDING_MODEL_NAME=text-embedding-v4
# Semantic execution routing: hard governance rules remain deterministic;
# the model only returns bounded goals, dependencies, tools, risk, and confidence.
AGENT_SEMANTIC_ROUTER_ENABLED=true
AGENT_SEMANTIC_ROUTER_MAX_TOKENS=700
AGENT_SEMANTIC_ROUTER_CONFIDENCE=0.65
AGENT_MIN_EXECUTION_TOKENS_AFTER_ROUTING=900

# Optional overrides
AGENT_ALLOWED_TOOLS=rag_summarize,get_weather,get_user_location,get_user_id,get_current_month,fetch_external_data,fill_context_for_report,lookup_error_code,get_product_specs,create_support_ticket
AGENT_TRACE_ENABLED=true
AGENT_API_KEY=dev-api-key
# principal_api_key（默认）将 API Key 绑定到服务端身份；jwt 使用 HS256 Bearer Token；
# legacy_headers 仅用于旧测试/迁移，禁止用于生产。
AGENT_AUTH_MODE=principal_api_key
AGENT_API_TENANT_ID=tenant-a
AGENT_API_USER_ID=user-1005
AGENT_API_USER_ROLE=user
AGENT_API_DATA_USER_ID=1005
# Local/development operator credentials. Leave blank when an external identity
# provider or AGENT_API_PRINCIPALS_JSON supplies these principals.
AGENT_OPERATOR_API_KEY=
AGENT_OPERATOR_USER_ID=operator-local
AGENT_OPERATOR_TENANT_ID=tenant-a
AGENT_ADMIN_API_KEY=
AGENT_ADMIN_USER_ID=admin-local
AGENT_ADMIN_TENANT_ID=tenant-a
AGENT_API_PRINCIPALS_JSON=
AGENT_JWT_SECRET=
AGENT_JWT_ISSUER=
AGENT_JWT_AUDIENCE=
AGENT_JWT_REQUIRE_EXP=true
AGENT_UI_BEARER_TOKEN=
AGENT_API_BASE_URL=http://127.0.0.1:8000
AGENT_UI_TENANT_ID=tenant-a
AGENT_UI_USER_ID=user-1005
AGENT_UI_USER_ROLE=user
AGENT_DB_PATH=storage/agent.db
AGENT_MEMORY_CONTEXT_TOKENS=6000
AGENT_MEMORY_VECTOR_ENABLED=false
AGENT_MEMORY_VECTOR_PATH=storage/memory_chroma
AGENT_MEMORY_MIN_SCORE=0.35
AGENT_MEMORY_MIN_RELEVANCE=0.08
AGENT_MEMORY_STALE_THRESHOLD=0.15
# 混合抽取：高精度规则兜底，模型仅提出结构化候选，确定性策略层负责验收和写入。
AGENT_MEMORY_MODEL_EXTRACTION_ENABLED=true
AGENT_MEMORY_EXTRACTION_MAX_TOKENS=900
AGENT_MEMORY_EXPLICIT_CONFIDENCE=0.70
AGENT_MEMORY_IMPLICIT_CONFIDENCE=0.85
AGENT_MEMORY_RETENTION_ENABLED=true
AGENT_MEMORY_RETENTION_INTERVAL_SECONDS=86400
AGENT_RATE_LIMIT_REQUESTS=60
AGENT_RATE_LIMIT_WINDOW_SECONDS=60

# Optional rerank experiment overrides (production remains disabled by default)
AGENT_CHROMA_CONFIG_PATH=config/chroma.yml
AGENT_RERANK_ENABLED=false
AGENT_RERANK_BACKEND=local
AGENT_RERANK_URL=http://127.0.0.1:8090/rerank
AGENT_RERANK_MODEL=BAAI/bge-reranker-v2-m3
AGENT_RERANK_TIMEOUT_SECONDS=2.0
AGENT_RERANK_FAILURE_THRESHOLD=3
AGENT_RERANK_RECOVERY_SECONDS=30.0
AGENT_RERANK_VERSION=bge-policy-v3
AGENT_RERANK_STRATEGY=shadow
AGENT_RERANK_HYBRID_WEIGHT=0.9
AGENT_RERANK_MODEL_WEIGHT=0.1
AGENT_RERANK_FUSION_K=10
AGENT_RERANK_BYPASS_EXACT_QUERIES=true
AGENT_RERANK_MAX_DOCUMENT_CHARS=1200
AGENT_RERANK_SERVICE_PRELOAD=true
AGENT_RERANK_SERVICE_MAX_DOCUMENT_CHARS=4000

# Multi-instance production backends
AGENT_STORAGE_BACKEND=sqlite
AGENT_APPROVAL_BACKEND=sqlite
AGENT_ARTIFACT_BACKEND=sqlite
AGENT_DATABASE_URL=postgresql://agent:agent@127.0.0.1:5432/agent
AGENT_EVENT_BUS_BACKEND=memory
AGENT_RATE_LIMIT_BACKEND=memory
AGENT_CACHE_BACKEND=memory
AGENT_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_EVENT_REPLAY_SIZE=512
AGENT_EVENT_RETENTION_SECONDS=300

# OpenTelemetry OTLP export
AGENT_OTEL_ENABLED=false
AGENT_OTEL_INSTRUMENT_FASTAPI=true
OTEL_SERVICE_NAME=sweeper-agent
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# 单次运行预算：总 Token、单次模型输出、逻辑工具调用和执行步骤。
AGENT_MAX_RUN_TOKENS=32000
AGENT_MAX_MODEL_OUTPUT_TOKENS=2000
AGENT_MODEL_MAX_RETRIES=2
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_STEPS=8
AGENT_MAX_COST=1.0
AGENT_MAX_VERIFICATION_RETRIES=1
AGENT_MIN_REPAIR_TOKENS=4500
AGENT_RAG_MAX_OUTPUT_TOKENS=1600
AGENT_MAX_REACT_RECURSION=12
AGENT_SUMMARY_MAX_TOKENS=500
AGENT_MAX_RAG_CALLS=3
AGENT_FINAL_RESPONSE_TOKEN_RESERVE=4500
AGENT_RAG_DUPLICATE_THRESHOLD=0.55

# LangSmith tracing (https://smith.langchain.com)
# 把 LANGSMITH_API_KEY 替换成真实 Key 即可；LangChain/LangGraph 应用设好变量后自动开启 tracing。
# 重要：本应用 langchain_core==1.4.8 只认 LANGCHAIN_TRACING_V2，必须同时设置下面两行才会真正产生 trace。
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
LANGSMITH_PROJECT=sweeper-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
